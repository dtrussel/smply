# SPDX-License-Identifier: Apache-2.0
#
# See docs/quality-gates.md section 3 for the rationale behind each inclusion
# and each deliberate exclusion.
#
# Note: the Checks value below is a YAML folded scalar, so '#' inside it is NOT
# a comment -- it becomes part of the check list. Explanations go here instead.
#
# -clang-analyzer-optin.core.EnumCastOutOfRange: the check assumes an enum's
#   valid values are exactly its enumerators. That is false for a wire-format
#   enumeration: Group is open by design, so every 16-bit value is legal and
#   must round-trip unchanged (docs/protocol-notes.md section 2, smply/group.hpp).
#   Decoding a group is a static_cast from an arbitrary 16-bit value by
#   construction, so the check fires on correct code throughout the codec, the
#   groups layer and their tests.
#
# -performance-enum-size: underlying types here are chosen to match the wire
#   format and to leave room for protocol growth, not to minimise sizeof. Group
#   must be uint16_t because the SMP header carries 16 bits
#   (docs/protocol-notes.md section 2); the check would fight every protocol
#   enumeration for no benefit.
---
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  cert-*,
  -cert-err58-cpp,
  clang-analyzer-*,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  concurrency-*,
  cppcoreguidelines-pro-type-reinterpret-cast,
  cppcoreguidelines-pro-type-const-cast,
  cppcoreguidelines-pro-type-cstyle-cast,
  cppcoreguidelines-owning-memory,
  cppcoreguidelines-slicing,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-narrowing-conversions,
  misc-*,
  -misc-non-private-member-variables-in-classes,
  -misc-include-cleaner,
  modernize-*,
  -modernize-use-trailing-return-type,
  performance-*,
  -performance-enum-size,
  readability-*,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-function-cognitive-complexity

WarningsAsErrors: '*'
HeaderFilterRegex: '(include/smply|src)/.*'
FormatStyle: file
